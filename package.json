{
  "name": "@deftai/canonical",
  "version": "0.3.0",
  "description": "The canonical pack: a compact, deterministic agent-workflow framework -- xBRIEF-based state, 20 CLI verbs, fail-closed git gates. Install globally, run `canon init` in any project.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "canon": "dist/cli/bin.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "content",
    "tasks",
    ".githooks",
    "Taskfile.yml"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deftai/canonical.git"
  },
  "homepage": "https://github.com/deftai/canonical#readme",
  "bugs": {
    "url": "https://github.com/deftai/canonical/issues"
  },
  "keywords": [
    "ai-agent",
    "agent-workflow",
    "claude",
    "agents-md",
    "task-runner",
    "briefs"
  ],
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "test": "vitest run --coverage",
    "test:fast": "vitest run",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^3.2.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
